DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cwtimeclock?schema=public
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Toronto
# Generate: openssl rand -hex 32
APP_SECRET=replace-with-at-least-32-random-characters
# Used only by npm run db:seed; no default password is shipped.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=
OWNER_FIRST_NAME=Nelson
OWNER_LAST_NAME=Evans
# smtp in production; console is only allowed outside production.
EMAIL_PROVIDER=console
EMAIL_FROM=Cedar Winds <timeclock@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Optional real logo at public/cedar-winds-logo.png
NEXT_PUBLIC_LOGO_URL=
