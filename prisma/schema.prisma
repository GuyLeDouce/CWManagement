  PRECONSTRUCTION
  DESIGN
  ESTIMATING
  CONTRACT_PENDING
  ACTIVE
  ON_HOLD
  SUBSTANTIALLY_COMPLETE
  WARRANTY
  COMPLETE
  ARCHIVED
}

enum ProjectAssignmentRole {
  PRIMARY_PROJECT_MANAGER
  SECONDARY_PROJECT_MANAGER
  ESTIMATOR
  DESIGNER
  CONTROLLER
  FIELD_STAFF
  OTHER
}

enum ContactType {
  CLIENT
  PROSPECT
  SUBTRADE
  VENDOR
  CONSULTANT
  ENGINEER
  ARCHITECT
  DESIGNER
  OTHER
}

enum ProjectContactRole {
  CLIENT
  ARCHITECT
  ENGINEER
  DESIGNER
  CONSULTANT
  SUBTRADE
  VENDOR
  ELECTRICIAN
  PLUMBER
  SUPPLIER
  SUBCONTRACTOR
  OTHER
}

enum ProjectTaskStatus {
  NOT_STARTED
  READY
  IN_PROGRESS
  BLOCKED
  COMPLETE
  CANCELLED
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

enum FileKind {
  DOCUMENT
  PHOTO
}

enum FileCategory {
  DRAWING
  PERMIT
  CONTRACT
  ENGINEERING
  SITE_PHOTO
  INVOICE
  WARRANTY
  SELECTION
  DAILY_LOG
  OTHER
}

enum FileVisibility {
  INTERNAL
  CLIENT
  TRADE
}

enum NotificationType {
  PROJECT_ASSIGNED
  TASK_ASSIGNED
  TASK_DUE
  TIME_APPROVAL
  PROJECT_STATUS
  DAILY_LOG
  GENERAL
}

enum CostCodeType {
  LABOUR
  MATERIAL
  SUBCONTRACT
  EQUIPMENT
  OTHER
}

enum EstimateStatus {
  DRAFT
  INTERNAL_REVIEW
  READY
  SENT
  ACCEPTED
  REJECTED
  SUPERSEDED
  ARCHIVED
}

enum MarkupMethod {
  NONE
  PERCENT_ON_COST
  FIXED
}

enum ProposalStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum BudgetVersionType {
  ORIGINAL
  CURRENT
  REFORECAST
  CHANGE_ORDER
}

enum CommitmentStatus {
  DRAFT
  COMMITTED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum FinancialSourceType {
  MANUAL
  PURCHASE_ORDER
  SUBCONTRACT
  VENDOR_COMMITMENT
  TIME
  QUICKBOOKS_BILL
  QUICKBOOKS_CREDIT_CARD
  QUICKBOOKS_CHEQUE
  QUICKBOOKS_PAYROLL
  OTHER
}

enum SyncDirection {
  IMPORT
  EXPORT
  BIDIRECTIONAL
}

enum SyncStatus {
  NOT_SYNCED
  PENDING
  SYNCED
  ERROR
  CONFLICT
}

enum SegmentType {
  SHOP
  SITE
  OFFICE
  TRAVEL
}

enum RecordStatus {
  RECORDED
  PENDING_PM_APPROVAL
  PM_APPROVED
  EXPORTED
}

enum QrType {
  SHOP
  TRUCK
}

enum TokenPurpose {
  RESET_PASSWORD
  DESKTOP
}

model User {
  portalContact              Contact?
  portalAccess               ClientProjectAccess[]
  selectionDecisions         SelectionDecision[]
  clientApprovals            ClientApproval[]
  clientMessages             ProjectMessage[]
  conversationReads          ConversationRead[]
  id                         String                @id @default(cuid())
  firstName                  String
  lastName                   String
  email                      String                @unique
  passwordHash               String?
  active                     Boolean               @default(true)
  roles                      Role[]
  earliestStart              String                @default("07:00")
  timezone                   String?
  createdAt                  DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime              @updatedAt @db.Timestamptz(3)
  sessions                   Session[]
  tokens                     ActionToken[]
  jobs                       EmployeeJobsite[]
  tasks                      EmployeeTask[]
  managedEmployees           PmEmployee[]          @relation("Manager")
  managers                   PmEmployee[]          @relation("Employee")
  managedJobs                PmJobsite[]
  workDays                   WorkDay[]
  segments                   TimeSegment[]
  approvals                  Approval[]
  visits                     SiteVisit[]
  audit                      AuditLog[]
  punches                    PunchReceipt[]
  exports                    ExportBatch[]
  employee                   Employee?
  capabilities               UserCapability[]
  projectAssignments         ProjectAssignment[]
  createdProjectTasks        ProjectTask[]         @relation("ProjectTaskCreator")
  projectTaskAssignments     ProjectTaskAssignee[]
  dailyLogs                  DailyLog[]
  uploadedFiles              StoredFile[]
  notifications              Notification[]
  estimatesCreated           EstimateRevision[]    @relation("EstimateRevisionCreator")
  proposalsCreated           ProposalRevision[]    @relation("ProposalRevisionCreator")
  proposalsAccepted          ProposalRevision[]    @relation("ProposalRevisionAcceptor")
  budgetVersionsCreated      BudgetVersion[]       @relation("BudgetVersionCreator")
  actualCostsCreated         ActualCost[]          @relation("ActualCostCreator")
  forecastAdjustmentsCreated ForecastAdjustment[]  @relation("ForecastAdjustmentCreator")
}

model Employee {
  id               String   @id @default(cuid())
  userId           String   @unique
  employeeNumber   String?  @unique
  title            String?
  active           Boolean  @default(true)
  quickBooksListId String?  @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
}

model UserCapability {
  userId     String
  capability Capability
  granted    Boolean    @default(true)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, capability])
}

model EmployeeJobsite {
  userId    String
  jobsiteId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  jobsite   Project @relation(fields: [jobsiteId], references: [id], onDelete: Restrict)

  @@id([userId, jobsiteId])
}

model EmployeeTask {
  userId String
  taskId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@id([userId, taskId])
}

model PmEmployee {
  pmId       String
  employeeId String
  pm         User   @relation("Manager", fields: [pmId], references: [id], onDelete: Restrict)
  employee   User   @relation("Employee", fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([pmId, employeeId])
}

model PmJobsite {
  pmId      String
  jobsiteId String
  pm        User    @relation(fields: [pmId], references: [id], onDelete: Restrict)
  jobsite   Project @relation(fields: [jobsiteId], references: [id], onDelete: Restrict)

  @@id([pmId, jobsiteId])
}

model Project {
  portalAccess           ClientProjectAccess[]
  allowances             Allowance[]
  selections             Selection[]
  conversations          Conversation[]
  clientTargetCompletion DateTime?               @db.Date
  purchasingDocuments    PurchasingDocument[]
  changeOrders           ChangeOrder[]
  contractAdjustments    ContractAdjustment[]
  id                     String                  @id @default(cuid())
  name                   String
  number                 String                  @unique
  address                String?
  overhead               Boolean                 @default(false)
  active                 Boolean                 @default(true)
  employees              EmployeeJobsite[]
  managers               PmJobsite[]
  tasks                  JobsiteTask[]
  mappings               AccountingMapping[]
  segments               TimeSegment[]
  visits                 SiteVisit[]
  trucks                 Truck[]
  description            String?
  projectType            String?
  status                 ProjectStatus           @default(ACTIVE)
  stage                  String?
  municipality           String?
  province               String?                 @default("ON")
  postalCode             String?
  startDate              DateTime?               @db.Date
  targetCompletion       DateTime?               @db.Date
  actualCompletion       DateTime?               @db.Date
  contractAmount         Decimal?                @db.Decimal(14, 2)
  internalNotes          String?
  clientVisibleNotes     String?
  archivedAt             DateTime?               @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  assignments            ProjectAssignment[]
  contacts               ProjectContact[]
  syncMappings           AccountingSyncMapping[]
  scheduleTasks          ProjectTask[]
  dailyLogs              DailyLog[]
  files                  StoredFile[]
  notifications          Notification[]
  activity               AuditLog[]
  estimates              Estimate[]
  proposals              Proposal[]
  budgets                Budget[]
  commitments            Commitment[]
  actualCosts            ActualCost[]
  forecastAdjustments    ForecastAdjustment[]

  @@map("Jobsite")
}

model ProjectAssignment {
  id        String                @id @default(cuid())
  projectId String
  userId    String
  role      ProjectAssignmentRole
  primary   Boolean               @default(false)
  project   Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime              @default(now()) @db.Timestamptz(3)

  @@unique([projectId, userId, role])
  @@index([userId, role])
}

model Company {
  active           Boolean   @default(true)
  id               String    @id @default(cuid())
  name             String    @unique
  legalName        String?
  email            String?
  phone            String?
  website          String?
  address          String?
  municipality     String?
  province         String?
  postalCode       String?
  notes            String?
  quickBooksListId String?   @unique
  contacts         Contact[]
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
}

model Contact {
  selectionOptions     SelectionOption[]
  portalUser           User?                 @relation(fields: [portalUserId], references: [id], onDelete: Restrict)
  portalAccess         ClientProjectAccess[]
  purchasingRevisions  PurchasingRevision[]  @relation("PurchasingVendor")
  billingRevisions     PurchasingRevision[]  @relation("PurchasingBilling")
  changeOrderRevisions ChangeOrderRevision[]
  id                   String                @id @default(cuid())
  firstName            String
  lastName             String
  companyId            String?
  email                String?
  phone                String?
  address              String?
  municipality         String?
  province             String?
  postalCode           String?
  notes                String?
  types                ContactType[]
  active               Boolean               @default(true)
  portalUserId         String?               @unique
  company              Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  projects             ProjectContact[]
  taskAssignments      ProjectTaskAssignee[]
  proposals            ProposalRevision[]
  commitments          Commitment[]
  actualCosts          ActualCost[]
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)

  @@index([lastName, firstName])
  @@index([companyId])
}

model ProjectContact {
  projectId String
  contactId String
  role      ProjectContactRole
  primary   Boolean            @default(false)
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  contact   Contact            @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@id([projectId, contactId, role])
  @@index([contactId])
}

model AccountingSyncMapping {
  id               String        @id @default(cuid())
  entityType       String
  entityId         String
  quickBooksListId String?
  quickBooksTxnId  String?
  direction        SyncDirection @default(BIDIRECTIONAL)
  status           SyncStatus    @default(NOT_SYNCED)
  lastSyncedAt     DateTime?     @db.Timestamptz(3)
  lastError        String?
  projectId        String?
  project          Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([entityType, entityId])
  @@index([status])
}

model ProjectTask {
  clientVisible       Boolean                 @default(false)
  clientTitle         String?
  clientDescription   String?
  purchasingRevisions PurchasingRevision[]
  id                  String                  @id @default(cuid())
  projectId           String
  name                String
  description         String?
  status              ProjectTaskStatus       @default(NOT_STARTED)
  startDate           DateTime?               @db.Date
  endDate             DateTime?               @db.Date
  actualStartDate     DateTime?               @db.Date
  actualEndDate       DateTime?               @db.Date
  milestone           Boolean                 @default(false)
  sortOrder           Int                     @default(0)
  createdById         String
  archivedAt          DateTime?               @db.Timestamptz(3)
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  project             Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy           User                    @relation("ProjectTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignees           ProjectTaskAssignee[]
  predecessors        ProjectTaskDependency[] @relation("Successor")
  successors          ProjectTaskDependency[] @relation("Predecessor")

  @@index([projectId, archivedAt, startDate])
  @@index([status, endDate])
}

model ProjectTaskAssignee {
  id        String      @id @default(cuid())
  taskId    String
  userId    String?
  contactId String?
  task      ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  contact   Contact?    @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@unique([taskId, userId])
  @@unique([taskId, contactId])
  @@index([userId])
  @@index([contactId])
}

model ProjectTaskDependency {
  predecessorId String
  successorId   String
  type          DependencyType @default(FINISH_TO_START)
  lagDays       Int            @default(0)
  predecessor   ProjectTask    @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     ProjectTask    @relation("Successor", fields: [successorId], references: [id], onDelete: Cascade)

  @@id([predecessorId, successorId])
  @@index([successorId])
}

model DailyLog {
  clientSummary  String?
  id             String       @id @default(cuid())
  projectId      String
  date           DateTime     @db.Date
  authorId       String
  workCompleted  String?
  siteConditions String?
  weatherNotes   String?
  manpowerNotes  String?
  delaysIssues   String?
  deliveries     String?
  visitors       String?
  inspections    String?
  generalNotes   String?
  clientVisible  Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  attachments    StoredFile[]

  @@unique([projectId, date, authorId])
  @@index([projectId, date])
}

model StoredFile {
  id               String         @id @default(cuid())
  projectId        String
  uploaderId       String
  dailyLogId       String?
  kind             FileKind
  category         FileCategory   @default(OTHER)
  visibility       FileVisibility @default(INTERNAL)
  filename         String
  originalFilename String
  mimeType         String
  size             BigInt
  storageKey       String         @unique
  description      String?
  caption          String?
  uploadedAt       DateTime       @default(now()) @db.Timestamptz(3)
  archivedAt       DateTime?      @db.Timestamptz(3)
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
