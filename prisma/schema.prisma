  contactId   String
  snapshot    Json
  comments    String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  selection   Selection       @relation(fields: [selectionId], references: [id], onDelete: Restrict)
  option      SelectionOption @relation(fields: [optionId], references: [id], onDelete: Restrict)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model ClientApproval {
  id           String              @id @default(cuid())
  revisionId   String              @unique
  userId       String
  contactId    String
  action       String
  typedName    String
  snapshot     Json
  snapshotHash String
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  revision     ChangeOrderRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Conversation {
  id                    String               @id @default(cuid())
  projectId             String
  subject               String
  audience              ConversationAudience @default(INTERNAL)
  selectionId           String?
  changeOrderRevisionId String?
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  project               Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  selection             Selection?           @relation(fields: [selectionId], references: [id], onDelete: Restrict)
  changeOrderRevision   ChangeOrderRevision? @relation(fields: [changeOrderRevisionId], references: [id], onDelete: Restrict)
  messages              ProjectMessage[]
  reads                 ConversationRead[]

  @@index([projectId, audience])
}

model ProjectMessage {
  id             String       @id @default(cuid())
  conversationId String
  authorId       String
  body           String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
}

model ConversationRead {
  conversationId String
  userId         String
  readAt         DateTime     @default(now()) @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
}
