enum PurchasingType {
  PURCHASE_ORDER
  WORK_ORDER
}

enum PurchasingStatus {
  DRAFT
  INTERNAL_REVIEW
  APPROVED
  ISSUED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  SUPERSEDED
}

enum ChangeOrderStatus {
  DRAFT
  INTERNAL_REVIEW
  READY
  ISSUED
  ACCEPTED
  REJECTED
  VOID
  SUPERSEDED
}

model PurchasingDocument {
  id          String               @id @default(cuid())
  projectId   String
  type        PurchasingType
  number      String               @unique
  cancelledAt DateTime?            @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revisions   PurchasingRevision[]
  commitment  Commitment?

  @@index([projectId, type])
}

model PurchasingRevision {
  id                    String               @id @default(cuid())
  documentId            String
  revision              Int
  version               Int                  @default(1)
  status                PurchasingStatus     @default(DRAFT)
  vendorContactId       String
  billingContactId      String?
  changeOrderRevisionId String?
  scheduleTaskId        String?
  attachmentIds         String[]             @default([])
  title                 String
  scope                 String?
  terms                 String?
  internalNotes         String?
  vendorNotes           String?
  expectedDate          DateTime?            @db.Date
  taxRate               Decimal              @db.Decimal(7, 6)
  snapshot              Json?
  subtotal              Decimal              @default(0) @db.Decimal(18, 2)
  taxAmount             Decimal              @default(0) @db.Decimal(18, 2)
  total                 Decimal              @default(0) @db.Decimal(18, 2)
  createdById           String
  approvedById          String?
  issuedById            String?
  approvedAt            DateTime?            @db.Timestamptz(3)
  issuedAt              DateTime?            @db.Timestamptz(3)
  acknowledgedAt        DateTime?            @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)
  document              PurchasingDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  vendorContact         Contact              @relation("PurchasingVendor", fields: [vendorContactId], references: [id], onDelete: Restrict)
  billingContact        Contact?             @relation("PurchasingBilling", fields: [billingContactId], references: [id], onDelete: Restrict)
  changeOrderRevision   ChangeOrderRevision? @relation(fields: [changeOrderRevisionId], references: [id], onDelete: Restrict)
  scheduleTask          ProjectTask?         @relation(fields: [scheduleTaskId], references: [id], onDelete: Restrict)
  lines                 PurchasingLine[]

  @@unique([documentId, revision])
}

model PurchasingLine {
  id                   String             @id @default(cuid())
  revisionId           String
  lineKey              String
  costCodeId           String
  costCodeSnapshot     String
  costCodeNameSnapshot String
  costType             CostCodeType
  description          String
  quantity             Decimal            @db.Decimal(18, 4)
  unit                 String
  unitCost             Decimal            @db.Decimal(18, 4)
  amount               Decimal            @db.Decimal(18, 2)
  taxable              Boolean            @default(true)
  sortOrder            Int                @default(0)
  internalNotes        String?
  revision             PurchasingRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  costCode             CostCode           @relation(fields: [costCodeId], references: [id], onDelete: Restrict)

  @@unique([revisionId, lineKey])
}

model ChangeOrder {
  selection          Selection?
  id                 String                @id @default(cuid())
  projectId          String
  number             String                @unique
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revisions          ChangeOrderRevision[]
  contractAdjustment ContractAdjustment?

  @@index([projectId])
}

model ChangeOrderRevision {
  clientApproval      ClientApproval?
  conversations       Conversation[]
  id                  String               @id @default(cuid())
  changeOrderId       String
  revision            Int
  version             Int                  @default(1)
  status              ChangeOrderStatus    @default(DRAFT)
  title               String
  description         String?
  category            String?
  internalNotes       String?
  scope               String?
  terms               String?
  clientId            String?
  attachmentIds       String[]             @default([])
  scheduleDays        Int                  @default(0)
  taxRate             Decimal              @db.Decimal(7, 6)
  snapshot            Json?
  costTotal           Decimal              @default(0) @db.Decimal(18, 2)
  subtotal            Decimal              @default(0) @db.Decimal(18, 2)
  taxAmount           Decimal              @default(0) @db.Decimal(18, 2)
  total               Decimal              @default(0) @db.Decimal(18, 2)
  createdById         String
  approvedById        String?
  issuedById          String?
  acceptedById        String?
  acceptedByName      String?
  acceptanceMethod    String?
  acceptanceReference String?
  approvedAt          DateTime?            @db.Timestamptz(3)
  issuedAt            DateTime?            @db.Timestamptz(3)
  acceptedAt          DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  changeOrder         ChangeOrder          @relation(fields: [changeOrderId], references: [id], onDelete: Restrict)
  client              Contact?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lines               ChangeOrderLine[]
  purchasingRevisions PurchasingRevision[]
  contractAdjustment  ContractAdjustment?
  budgetVersion       BudgetVersion?

  @@unique([changeOrderId, revision])
}

model ChangeOrderLine {
  id                   String              @id @default(cuid())
  revisionId           String
  costCodeId           String
  costCodeSnapshot     String
  costCodeNameSnapshot String
  costType             CostCodeType
  description          String
  clientDescription    String?
  quantity             Decimal             @db.Decimal(18, 4)
  unit                 String
  unitCost             Decimal             @db.Decimal(18, 4)
  markupMethod         MarkupMethod        @default(NONE)
  markupValue          Decimal             @default(0) @db.Decimal(18, 4)
  taxable              Boolean             @default(true)
  sortOrder            Int                 @default(0)
  revision             ChangeOrderRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  costCode             CostCode            @relation(fields: [costCodeId], references: [id], onDelete: Restrict)

  @@index([revisionId])
}

model ContractAdjustment {
  id            String              @id @default(cuid())
  projectId     String
  changeOrderId String              @unique
  revisionId    String              @unique
  amount        Decimal             @db.Decimal(18, 2)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  changeOrder   ChangeOrder         @relation(fields: [changeOrderId], references: [id], onDelete: Restrict)
  revision      ChangeOrderRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@index([projectId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

