  CLIENT_ACCESS_MANAGE
  CLIENT_CONTENT_PUBLISH
  SELECTION_VIEW
  SELECTION_CREATE
  SELECTION_EDIT
  SELECTION_PUBLISH
  SELECTION_APPROVE_INTERNAL
  CLIENT_MESSAGE_VIEW
  CLIENT_MESSAGE_SEND
  PURCHASE_ORDER_VIEW
  PURCHASE_ORDER_EDIT
  PURCHASE_ORDER_APPROVE
  PURCHASE_ORDER_ISSUE
  WORK_ORDER_VIEW
  WORK_ORDER_CREATE
  WORK_ORDER_EDIT
  WORK_ORDER_APPROVE
  WORK_ORDER_ISSUE
  CHANGE_ORDER_VIEW
  CHANGE_ORDER_EDIT
  CHANGE_ORDER_APPROVE_INTERNAL
  CHANGE_ORDER_ISSUE
  CHANGE_ORDER_ACCEPT
  COMMITMENT_VIEW
  COMMITMENT_MANAGE
  ACTUAL_COST_RECONCILE
  PROJECT_VIEW_ALL
  PROJECT_VIEW_ASSIGNED
  PROJECT_CREATE
